{
  "name": "workstation",
  "version": "0.1.0",
  "description": "Infinite canvas for developers using Claude — organized, streamlined, terminal-first.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "lint": "eslint src --ext .ts,.tsx",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@xyflow/react": "^12.0.0",
    "immer": "^10.1.1",
    "nanoid": "^5.0.7",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.9.0",
    "electron-store": "^8.1.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^9.4.3",
    "node-pty": "^1.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "build": {
    "appId": "com.workstation.app",
    "productName": "Workstation",
    "directories": { "output": "dist" },
    "files": ["electron/**/*", "dist-react/**/*"],
    "mac": { "category": "public.app-category.developer-tools" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
